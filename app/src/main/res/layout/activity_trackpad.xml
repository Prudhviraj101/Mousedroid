<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- Top Glass Navigation & Mode Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_live"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_dot_green"
                android:contentDescription="Connected" />

            <TextView
                android:id="@+id/tvServerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.100"
                android:textColor="@color/accent_lime"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- 4-Mode Selector Capsule Pills -->
    <LinearLayout
        android:id="@+id/modeSelectorBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_card_subtle"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tabTrackpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_chip_active"
            android:gravity="center"
            android:text="@string/tab_trackpad"
            android:textColor="@color/pill_active_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMedia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:gravity="center"
            android:text="@string/tab_media"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabHotkeys"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:gravity="center"
            android:text="@string/tab_hotkeys"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabNumpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:gravity="center"
            android:text="@string/tab_numpad"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Interactive Area Container -->
    <FrameLayout
        android:id="@+id/centerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomControlSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modeSelectorBar">

        <!-- 1. Modern Trackpad Canvas -->
        <com.example.mousedroid.ModernTrackpadView
            android:id="@+id/modernTrackpadView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_trackpad_surface" />

        <!-- 2. Media & Presentation Controls Panel -->
        <ScrollView
            android:id="@+id/panelMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card"
            android:overScrollMode="never"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Media &amp; Presentation Suite"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Media Playback Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMediaPrev"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_skip_prev"
                        android:contentDescription="Previous"
                        app:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/btnMediaPlayPause"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_circle_button_white"
                        android:src="@drawable/ic_play"
                        android:contentDescription="Play/Pause" />

                    <ImageButton
                        android:id="@+id/btnMediaNext"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_skip_next"
                        android:contentDescription="Next"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <!-- Volume Controls Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnVolumeDown"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_volume_down"
                        android:contentDescription="Volume Down"
                        app:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/btnVolumeMute"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="@drawable/bg_circle_button_amber"
                        android:src="@drawable/ic_volume_mute"
                        android:contentDescription="Mute"
                        app:tint="@color/pill_active_text" />

                    <ImageButton
                        android:id="@+id/btnVolumeUp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_volume_up"
                        android:contentDescription="Volume Up"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <!-- Presentation Controls Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Slide Deck &amp; Video Controls"
                    android:textColor="@color/accent_amber"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Slide Navigation Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSlidePrev"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="◀ Prev Slide"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnSlideNext"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Next Slide ▶"
                        android:textColor="@color/accent_lime"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Presentation Extras: Fullscreen, Blank Screen, Space -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSpace"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Space"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnBlankScreen"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Blank (B)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnFullscreen"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Fullscreen (F5)"
                        android:textColor="@color/accent_amber"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 3. Hotkeys & Power Deck Panel -->
        <ScrollView
            android:id="@+id/panelHotkeys"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card"
            android:overScrollMode="never"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editing &amp; Clipboard"
                    android:textColor="@color/accent_lime"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Row 1: Copy, Paste, Undo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCopy"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Ctrl+C"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPaste"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Ctrl+V"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnUndo"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Ctrl+Z"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Row 2: Select All, Cut, Redo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSelectAll"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Ctrl+A"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCut"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Ctrl+X"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnRedo"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Ctrl+Y"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Window &amp; Browser Navigation"
                    android:textColor="@color/accent_amber"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Row 3: New Tab, Close Tab, Reopen Tab -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNewTab"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="New Tab"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCloseTab"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Close Tab"
                        android:textColor="@color/accent_coral"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnReopenTab"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Reopen Tab"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Row 4: Snipping Tool, File Explorer, Close App -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnScreenshot"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Screenshot"
                        android:textColor="@color/accent_lime"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnExplorer"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Explorer"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCloseApp"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Alt+F4"
                        android:textColor="@color/accent_coral"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="System &amp; Workspace"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Row 5: Alt+Tab, Win Key, Show Desktop -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAltTab"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Alt + Tab"
                        android:textColor="@color/accent_lime"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnWinKey"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Win Key"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnShowDesktop"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Desktop"
                        android:textColor="@color/accent_amber"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Row 6: Task Manager, Lock PC, Esc -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTaskMgr"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1.2"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Task Mgr"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnLockPc"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Lock PC"
                        android:textColor="@color/accent_coral"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnEsc"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="0.9"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="Esc"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 4. Numpad & D-Pad Panel -->
        <ScrollView
            android:id="@+id/panelNumpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card"
            android:overScrollMode="never"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Numeric Keypad"
                    android:textColor="@color/accent_lime"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Row 1: 7 8 9 / -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNum7"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="7"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNum8"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="8"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNum9"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="9"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNumDiv"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="/"
                        android:textColor="@color/accent_amber"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Row 2: 4 5 6 * -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNum4"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="4"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNum5"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="5"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNum6"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="6"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNumMul"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="*"
                        android:textColor="@color/accent_amber"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Row 3: 1 2 3 - -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNum1"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="1"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNum2"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="2"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNum3"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="3"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNumSub"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="-"
                        android:textColor="@color/accent_amber"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Row 4: 0 . Enter + -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNum0"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNumDot"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="."
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnNumEnter"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_pill_button_primary"
                        android:text="↵"
                        android:textColor="@color/pill_active_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnNumAdd"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="+"
                        android:textColor="@color/accent_amber"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- D-Pad Directional Controls Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Directional D-Pad"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- D-Pad Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnDpadUp"
                        android:layout_width="72dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="▲"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnDpadLeft"
                            android:layout_width="72dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_pill_button_secondary"
                            android:text="◀"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnDpadCenter"
                            android:layout_width="72dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_pill_button_secondary"
                            android:text="OK"
                            android:textColor="@color/accent_lime"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnDpadRight"
                            android:layout_width="72dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_button_secondary"
                            android:text="▶"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDpadDown"
                        android:layout_width="72dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:text="▼"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Control & Tactile Click Section -->
    <LinearLayout
        android:id="@+id/bottomControlSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Split Click Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Left Click Button -->
            <LinearLayout
                android:id="@+id/leftClickButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_click_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/left_click"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Middle Click Pill -->
            <LinearLayout
                android:id="@+id/middleClickButton"
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/bg_click_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_badge_live" />
            </LinearLayout>

            <!-- Right Click Button -->
            <LinearLayout
                android:id="@+id/rightClickButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_click_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/right_click"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Floating Quick Toolbar (Keyboard, Voice, Clipboard, Quick Esc) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/keyboardButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button_secondary"
                android:drawableStart="@drawable/ic_keyboard"
                android:drawableTint="@color/accent_lime"
                android:paddingHorizontal="14dp"
                android:text="  Keyboard"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnQuickVoice"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_mic"
                android:contentDescription="Voice Typing"
                app:tint="@color/accent_lime" />

            <ImageButton
                android:id="@+id/btnQuickPaste"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_paste"
                android:contentDescription="Paste Clipboard"
                app:tint="@color/accent_amber" />

            <ImageButton
                android:id="@+id/btnQuickEsc"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_close"
                android:contentDescription="Esc Key"
                app:tint="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>